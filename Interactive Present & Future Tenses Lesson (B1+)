        <label><input type="radio" name="ex1q2" value="b"> leaves</label>
      </div>
      <div class="explanation" id="ex1q2-exp"></div>
    </div>

    <div class="question-block" id="ex1q3">
      <p><span class="q-number">3</span> Jack ___ basketball every week.</p>
      <div class="options">
        <label><input type="radio" name="ex1q3" value="a"> isn't playing</label>
        <label><input type="radio" name="ex1q3" value="b"> doesn't play</label>
      </div>
      <div class="explanation" id="ex1q3-exp"></div>
    </div>

    <div class="question-block" id="ex1q4">
