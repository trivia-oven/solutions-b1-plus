        <label><input type="radio" name="ex1q4" value="b"> gets</label>
      </div>
      <div class="explanation" id="ex1q4-exp"></div>
    </div>

    <div class="question-block" id="ex1q5">
      <p><span class="q-number">5</span> You ___ where you've put your keys!</p>
      <div class="options">
        <label><input type="radio" name="ex1q5" value="a"> always forget</label>
        <label><input type="radio" name="ex1q5" value="b"> are always forgetting</label>
      </div>
      <div class="explanation" id="ex1q5-exp"></div>
    </div>

    <div class="question-block" id="ex1q6">
      <p><span class="q-number">6</span> Our English teacher ___ from Manchester.</p>
      <div class="options">
        <label><input type="radio" name="ex1q6" value="a"> is coming</label>
        <label><input type="radio" name="ex1q6" value="b"> comes</label>
      </div>
      <div class="explanation" id="ex1q6-exp"></div>
    </div>

    <div class="question-block" id="ex1q7">
      <p><span class="q-number">7</span> I'll see you after the lesson ___.</p>
      <div class="options">
        <label><input type="radio" name="ex1q7" value="a"> finishes</label>
        <label><input type="radio" name="ex1q7" value="b"> is finishing</label>
      </div>
