<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Present & Future Tenses – B1+ Interactive Lesson</title>
<style>
  :root {
    --primary: #e67e22;
    --primary-dark: #d35400;
    --secondary: #3498db;
    --success: #27ae60;
    --danger: #e74c3c;
    --warning: #f39c12;
    --bg: #fef9f3;
    --card: #ffffff;
    --text: #2c3e50;
    --text-light: #7f8c8d;
    --border: #e8dcc8;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.7;
    padding: 20px;
    max-width: 1000px;
    margin: 0 auto;
  }

  h1 {
    text-align: center;
    color: var(--primary-dark);
    font-size: 2.2em;
    margin-bottom: 5px;
  }

  .subtitle {
    text-align: center;
    color: var(--text-light);
    margin-bottom: 25px;
    font-size: 1.05em;
  }

  .progress-bar-container {
    background: var(--border);
    border-radius: 20px;
    height: 14px;
    margin-bottom: 25px;
    overflow: hidden;
  }

  .progress-bar {
    background: linear-gradient(90deg, var(--primary), var(--primary-dark));
    height: 100%;
    width: 0%;
    border-radius: 20px;
    transition: width 0.5s ease;
  }

  .progress-text {
    text-align: center;
    font-size: 0.9em;
    color: var(--text-light);
    margin-bottom: 20px;
  }

  .section {
    background: var(--card);
    border-radius: 16px;
    padding: 28px 32px;
    margin-bottom: 24px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border-left: 5px solid var(--primary);
  }

  .section h2 {
    color: var(--primary-dark);
    font-size: 1.4em;
    margin-bottom: 8px;
  }

  .section .instruction {
    color: var(--text-light);
    font-size: 0.95em;
    margin-bottom: 18px;
    font-style: italic;
  }

  .tab-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
    justify-content: center;
  }

  .tab-btn {
    padding: 8px 16px;
    border: 2px solid var(--primary);
    border-radius: 20px;
    background: white;
    color: var(--primary-dark);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    font-size: 0.9em;
  }

  .tab-btn:hover, .tab-btn.active {
    background: var(--primary);
    color: white;
  }

  .tab-content { display: none; }
  .tab-content.active { display: block; }

  .dialogue-box {
    background: #fef5e7;
    border-radius: 12px;
    padding: 22px 26px;
    margin-bottom: 16px;
    border: 1px solid #fdebd0;
  }

  .dialogue-box .speaker {
    font-weight: 700;
    color: var(--primary-dark);
  }

  .dialogue-box .highlight {
    background: #fdebd0;
    padding: 1px 5px;
    border-radius: 4px;
    font-weight: 600;
    cursor: help;
    position: relative;
  }

  .dialogue-box .highlight:hover::after {
    content: attr(data-use);
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: var(--primary-dark);
    color: white;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.8em;
    white-space: nowrap;
    z-index: 10;
  }

  .question-block {
    margin-bottom: 18px;
    padding-bottom: 18px;
    border-bottom: 1px dashed var(--border);
  }

  .question-block:last-child {
    border-bottom: none;
  }

  .question-block p {
    margin-bottom: 8px;
    font-weight: 500;
  }

  .q-number {
    display: inline-block;
    background: var(--primary);
    color: white;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    text-align: center;
    line-height: 26px;
    font-size: 0.85em;
    margin-right: 8px;
    flex-shrink: 0;
  }

  .options label {
    display: block;
    padding: 8px 14px;
    margin: 5px 0;
    border: 2px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
    font-size: 0.95em;
  }

  .options label:hover {
    border-color: var(--primary);
    background: #fef5e7;
  }

  .options input[type="radio"] {
    margin-right: 8px;
    accent-color: var(--primary);
  }

  .options label.correct {
    border-color: var(--success);
    background: #eafaf1;
  }

  .options label.incorrect {
    border-color: var(--danger);
    background: #fdedec;
  }

  .options label.disabled {
    pointer-events: none;
    opacity: 0.7;
  }

  .fill-input {
    border: 2px solid var(--border);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 0.95em;
    width: 220px;
    transition: border-color 0.2s;
    outline: none;
  }

  .fill-input:focus {
    border-color: var(--primary);
  }

  .fill-input.correct {
    border-color: var(--success);
    background: #eafaf1;
  }

  .fill-input.incorrect {
    border-color: var(--danger);
    background: #fdedec;
  }

  .explanation {
    margin-top: 8px;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 0.9em;
    display: none;
    line-height: 1.6;
  }

  .explanation.show { display: block; }

  .explanation.correct-exp {
    background: #eafaf1;
    border-left: 4px solid var(--success);
    color: #1e8449;
  }

  .explanation.incorrect-exp {
    background: #fdedec;
    border-left: 4px solid var(--danger);
    color: #922b21;
  }

  .btn {
    display: inline-block;
    padding: 10px 24px;
    border: none;
    border-radius: 8px;
    font-size: 0.95em;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    margin-top: 10px;
  }

  .btn-check {
    background: var(--primary);
    color: white;
  }

  .btn-check:hover { background: var(--primary-dark); }

  .btn-reset {
    background: var(--warning);
    color: white;
    margin-left: 8px;
  }

  .btn-reset:hover { opacity: 0.85; }

  .score-display {
    margin-top: 12px;
    font-weight: 700;
    font-size: 1.05em;
    color: var(--primary-dark);
  }

  .grammar-box {
    background: #fef5e7;
    border: 2px solid var(--primary);
    border-radius: 12px;
    padding: 20px;
    margin: 16px 0;
  }

  .grammar-box h3 {
    color: var(--primary-dark);
    margin-bottom: 12px;
    font-size: 1.1em;
  }

  .grammar-box ul {
    margin-left: 20px;
    margin-bottom: 10px;
  }

  .grammar-box li {
    margin-bottom: 6px;
  }

  .grammar-box .example {
    color: var(--secondary);
    font-style: italic;
    margin-left: 10px;
  }

  .matching-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 10px;
  }

  .matching-item {
    padding: 10px 14px;
    border: 2px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
    text-align: center;
    font-size: 0.95em;
  }

  .matching-item:hover { border-color: var(--primary); }

  .matching-item.selected {
    border-color: var(--primary);
    background: #fef5e7;
    font-weight: 600;
  }

  .matching-item.matched {
    border-color: var(--success);
    background: #eafaf1;
    pointer-events: none;
  }

  .ccq-box {
    background: #eaf2f8;
    border-radius: 12px;
    padding: 18px 22px;
    margin-bottom: 14px;
    border-left: 4px solid var(--secondary);
  }

  .ccq-box .question {
    font-weight: 600;
    color: var(--secondary);
    margin-bottom: 8px;
  }

  .ccq-box .options label {
    display: inline-block;
    margin-right: 15px;
    padding: 6px 12px;
  }

  .qa-block {
    background: #fef5e7;
    border-radius: 12px;
    padding: 18px 22px;
    margin-bottom: 14px;
  }

  .qa-block .question-text {
    font-weight: 600;
    color: var(--primary-dark);
    margin-bottom: 8px;
  }

  .qa-block textarea {
    width: 100%;
    border: 2px solid var(--border);
    border-radius: 8px;
    padding: 10px;
    font-size: 0.95em;
    font-family: inherit;
    resize: vertical;
    min-height: 60px;
    outline: none;
    transition: border-color 0.2s;
  }

  .qa-block textarea:focus { border-color: var(--primary); }

  .qa-block .sample-answer {
    margin-top: 8px;
    padding: 10px 14px;
    background: #eafaf1;
    border-radius: 8px;
    font-size: 0.9em;
    color: #1e8449;
    display: none;
  }

  .qa-block .sample-answer.show { display: block; }

  .error-sentence {
    padding: 10px 14px;
    background: #fff8e1;
    border-radius: 8px;
    margin-bottom: 6px;
    font-size: 0.95em;
  }

  .habit-list {
    background: #fef5e7;
    padding: 16px 20px;
    border-radius: 10px;
    margin-bottom: 16px;
  }

  .habit-list ul {
    margin-left: 20px;
  }

  .habit-list li {
    margin-bottom: 6px;
  }

  .final-score {
    text-align: center;
    padding: 30px;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white;
    border-radius: 16px;
    margin-top: 20px;
    display: none;
  }

  .final-score.show { display: block; }

  .final-score h2 { font-size: 1.8em; margin-bottom: 10px; }

  .final-score .emoji { font-size: 3em; margin-bottom: 10px; }

  @media (max-width: 600px) {
    body { padding: 10px; }
    .section { padding: 18px 16px; }
    .matching-container { grid-template-columns: 1fr; }
    .fill-input { width: 100%; }
  }
</style>
</head>
