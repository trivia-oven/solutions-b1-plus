    const userAnswer = input.value.toLowerCase().trim();

    input.classList.remove('correct', 'incorrect');

    // Allow some flexibility
    const acceptableAnswers = [answer];
    if (answer === 'am using') acceptableAnswers.push('m using');
    if (answer === 'am revising') acceptableAnswers.push('m revising');
    if (answer === 'are trying') acceptableAnswers.push('re trying');
    if (answer === 'are always using') acceptableAnswers.push('re always using');

    if (acceptableAnswers.includes(userAnswer)) {
      score++;
      input.classList.add('correct');
    } else {
      input.classList.add('incorrect');
      input.title = `Correct answer: ${input.dataset.answer}`;
    }
  });

  document.getElementById('ex2-score').textContent = `Score: ${score} / ${total}`;
  completedExercises.add('ex2');
  updateProgress();
}

function resetEx2() {
  document.querySelectorAll('#tab-ex2 .fill-input').forEach(input => {
    input.value = '';
    input.classList.remove('correct', 'incorrect');
    input.title = '';
  });
  document.getElementById('ex2-score').textContent = '';
  completedExercises.delete('ex2');
  updateProgress();
}

