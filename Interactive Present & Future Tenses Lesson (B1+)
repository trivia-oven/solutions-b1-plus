  ex1q4: { correct: 'a', explanation: '<strong>Present continuous for changing situations:</strong> "The Earth\'s climate is getting hotter" – describes a change happening now/around now.' },
  ex1q5: { correct: 'b', explanation: '<strong>Present continuous with "always" for annoying behaviour:</strong> "You are always forgetting" – expresses irritation about a repeated action.' },
  ex1q6: { correct: 'b', explanation: '<strong>Present simple for permanent situations/facts:</strong> "Our English teacher comes from Manchester" – this is a permanent fact.' },
  ex1q7: { correct: 'a', explanation: '<strong>Present simple in future time clauses:</strong> "after the lesson finishes" – after "after", we use present simple, not future.' }
};

function checkEx1() {
  let score = 0;
  const total = Object.keys(ex1Answers).length;

  for (const [qid, data] of Object.entries(ex1Answers)) {
    const selected = document.querySelector(`input[name="${qid}"]:checked`);
    const expEl = document.getElementById(qid + '-exp');
    const labels = document.querySelectorAll(`#${qid} .options label`);

    labels.forEach(l => l.classList.add('disabled'));

    if (selected) {
      if (selected.value === data.correct) {
        score++;
        selected.parentElement.classList.add('correct');
        expEl.className = 'explanation show correct-exp';
      } else {
        selected.parentElement.classList.add('incorrect');
        labels.forEach(l => {
          if (l.querySelector('input').value === data.correct) l.classList.add('correct');
        });
        expEl.className = 'explanation show incorrect-exp';
      }
    } else {
      labels.forEach(l => {
        if (l.querySelector('input').value === data.correct) l.classList.add('correct');
      });
      expEl.className = 'explanation show incorrect-exp';
    }
    expEl.innerHTML = data.explanation;
  }

  document.getElementById('ex1-score').textContent = `Score: ${score} / ${total}`;
  completedExercises.add('ex1');
  updateProgress();
}

function resetEx1() {
  for (const qid of Object.keys(ex1Answers)) {
    document.querySelectorAll(`input[name="${qid}"]`).forEach(r => r.checked = false);
